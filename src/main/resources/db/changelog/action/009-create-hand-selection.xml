<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="action-009-create-hand-selection" author="game-service">
        <createTable tableName="hand_selection">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="game_id" type="UUID"><constraints nullable="false"/></column>
            <column name="era_number" type="INT"><constraints nullable="false"/></column>
            <column name="player_id" type="UUID"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(32)"><constraints nullable="false"/></column>
            <column name="selection_expires_at" type="TIMESTAMPTZ"><constraints nullable="false"/></column>
            <column name="dealt_cards" type="JSONB"><constraints nullable="false"/></column>
            <column name="selected_cards" type="JSONB"/>
            <column name="selection_origin" type="VARCHAR(32)"/>
        </createTable>
        <addUniqueConstraint tableName="hand_selection" columnNames="game_id,era_number,player_id"
                constraintName="uq_hand_selection_game_era_player"/>
        <createIndex tableName="hand_selection" indexName="idx_hand_selection_open_due">
            <column name="status"/><column name="selection_expires_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
