<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="scoring-011-create-scoring-context-action-fact" author="game-service">
        <createTable tableName="scoring_context_action_fact">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="game_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="era_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="player_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="faction" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="consumed" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
                tableName="scoring_context_action_fact"
                columnNames="game_id,era_number,player_id,reason"
                constraintName="uq_scoring_action_fact_game_era_player_reason"/>
    </changeSet>

</databaseChangeLog>
