<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="scoring-014-create-scoring-end-game-ledgers" author="game-service">
        <createTable tableName="scoring_faction_identification">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="game_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="player_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
                tableName="scoring_faction_identification"
                columnNames="game_id,player_id"
                constraintName="uq_scoring_faction_identification_game_player"/>

        <createTable tableName="scoring_end_game_score_fact">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="game_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="player_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
                tableName="scoring_end_game_score_fact"
                columnNames="game_id,player_id,reason"
                constraintName="uq_scoring_end_game_score_fact_game_player_reason"/>
    </changeSet>

</databaseChangeLog>
