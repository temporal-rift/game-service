<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="scoring-015-create-scoring-context-fulfillment-declaration" author="game-service">
        <createTable tableName="scoring_context_fulfillment_declaration">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="game_id" type="UUID"><constraints nullable="false"/></column>
            <column name="era_number" type="INT"><constraints nullable="false"/></column>
            <column name="player_id" type="UUID"><constraints nullable="false"/></column>
            <column name="target_event_id" type="UUID"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint
                tableName="scoring_context_fulfillment_declaration"
                columnNames="game_id,era_number,player_id,target_event_id"
                constraintName="uq_scoring_fulfillment_declaration_game_era_player_event"/>
    </changeSet>
</databaseChangeLog>
